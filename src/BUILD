# Framework core sources, grouped by language.
# Each language provides a `core` library target consumed by apps/services/tests.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "src",
    srcs = [
        "//src/java:core",
        "//src/cpp:core",
        "//src/rust:core",
        "//src/python:core",
        "//src/ts:core",
        "//src/go:host",
    ],
)
