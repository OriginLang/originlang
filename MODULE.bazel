module(
    name = "originlang",
    version = "0.1.0",
)

# Bazel 9 no longer ships built-in language rules (cc/java/etc.), they are
# provided by the independent rule sets below.

# C++
bazel_dep(
    name = "rules_cc",
    version = "0.2.22",
)

# Java
bazel_dep(
    name = "rules_java",
    version = "9.9.0",
)

# Rust
bazel_dep(
    name = "rules_rust",
    version = "0.73.0",
)

# Python
bazel_dep(
    name = "rules_python",
    version = "1.9.2",
)

# Go
bazel_dep(
    name = "rules_go",
    version = "0.63.0",
)

bazel_dep(
    name = "gazelle",
    version = "0.53.0",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.22.0")

# TypeScript / JS (aspect-based) - enable once TS sources are added:
#   bazel_dep(name = "aspect_rules_js", version = "2.1.2")
#   bazel_dep(name = "aspect_rules_ts", version = "3.1.0")
